# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Supabase CLI local cache (not source)
supabase/.temp/

# Windows MAX_PATH CMake junction (local build workaround only)
/n/

# Emulator / UI dump diagnostics (never commit)
seenzo-*.png
ui-dump.xml
uidump.xml
.tmp_*.png
.tmp_*.xml
scripts/parse-ui-dump.js
